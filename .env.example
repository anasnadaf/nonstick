# --- LLM (provider comes from the model strings; LiteLLM routes accordingly) ---
MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# OPENAI_API_KEY=sk-...
# Bedrock instead:
# MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0
# EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
# EMBEDDING_DIM=1024
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# Run with no API keys at all (deterministic offline model, for dev/tests)
# LLM_MOCK=1

# --- Storage ---
# Zero-infra local default is sqlite + FAISS:
# DATABASE_URL=sqlite+aiosqlite:///./data/nonstick.db
# VECTOR_BACKEND=faiss
DATABASE_URL=postgresql+asyncpg://nonstick:nonstick@localhost:5433/nonstick
VECTOR_BACKEND=pgvector

# --- Auth: unset => single-user dev mode; set => bearer verified at $AUTH_URL/auth/me ---
# AUTH_URL=http://auth:8081

# --- Tools ---
# TAVILY_API_KEY=tvly-...

# --- Observability ---
# MLFLOW_TRACKING_URI=http://localhost:5000

# --- Production only ---
# POSTGRES_USER=nonstick
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=nonstick

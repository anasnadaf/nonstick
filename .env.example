# --- LLM (provider comes from the model strings; LiteLLM routes accordingly) ---
MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIM=1536
# OPENAI_API_KEY=sk-...
# Bedrock instead:
# MODEL=bedrock/anthropic.claude-3-5-sonnet-20241022-v2:0
# EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0
# EMBEDDING_DIM=1024
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# AWS_REGION_NAME=us-east-1

# MODEL and EMBEDDING_MODEL are routed independently, so they can name
# different providers — which you need for a chat-only provider. DeepSeek, for
# one, has no /embeddings endpoint at all:
# MODEL=deepseek/deepseek-chat
# DEEPSEEK_API_KEY=sk-...
# EMBEDDING_MODEL=gemini/gemini-embedding-001
# EMBEDDING_DIM=3072          # gemini-embedding-001 returns 3072, not 768
# GEMINI_API_KEY=...
# (text-embedding-004 is retired and now 404s; gemini-embedding-001 or -2.)
#
# EMBEDDING_DIM must match what the model actually returns, and changing it
# invalidates any vectors already stored — clear ./data or re-ingest.

# Run with no API keys at all (deterministic offline model, for dev/tests)
# LLM_MOCK=1

# --- Storage ---
# Zero-infra local default is sqlite + FAISS:
# DATABASE_URL=sqlite+aiosqlite:///./data/nonstick.db
# VECTOR_BACKEND=faiss
DATABASE_URL=postgresql+asyncpg://nonstick:nonstick@localhost:5433/nonstick
VECTOR_BACKEND=pgvector

# --- Auth: unset => single-user dev mode; set => bearer verified at $AUTH_URL/auth/me ---
# AUTH_URL=http://auth:8081

# --- Tools ---
# TAVILY_API_KEY=tvly-...

# --- Observability ---
# Both MLflow and Prometheus are compose services — `uv run nonstick serve`
# alone starts neither, though /metrics is always served by the app itself.
# The mlflow CLI shipped here is the tracing client only; `mlflow server` needs
# Flask, so run the server from compose rather than the venv.
# MLFLOW_TRACKING_URI=http://localhost:5000
# Host ports for the compose services. macOS AirPlay Receiver squats on 5000:
# MLFLOW_PORT=5001
# PROMETHEUS_PORT=9090

# --- Production only ---
# POSTGRES_USER=nonstick
# POSTGRES_PASSWORD=change-me
# POSTGRES_DB=nonstick
